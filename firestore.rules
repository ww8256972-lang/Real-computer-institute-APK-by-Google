rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAdmin() { return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.role == 'admin' || request.auth.uid == 'admin_console'); }
    function isTeacher() { return isAuthenticated() && request.auth.token.role == 'teacher'; }

    match /students/{studentId} { allow read: if isAuthenticated(); allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == studentId); }
    match /teachers/{teacherId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /courses/{courseId} { allow read: if true; allow write: if isAdmin(); }
    match /batches/{batchId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /attendance/{attendanceId} { allow read: if isAuthenticated(); allow write: if isAdmin() || isAuthenticated(); }
    match /fee_records/{recordId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /timetables/{timetableId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /scheduled_exams/{examId} {
      allow read: if isAuthenticated(); allow write: if isAdmin();
      match /answerKey/{docId} { allow read, write: if isAdmin() || isTeacher(); }
    }
    match /exam_submissions/{submissionId} { allow read: if isAuthenticated(); allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid; allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin()); allow delete: if isAdmin(); }
    match /notices/{noticeId} { allow read: if true; allow write: if isAdmin(); }
    match /digital_certificates/{certId} { allow read: if true; allow write: if isAdmin(); }
    match /parent_guardians/{guardianId} { allow read: if isAuthenticated(); allow write: if isAdmin() || isOwner(guardianId); }
    match /erpRecords/{recordId} { allow read, write: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid); }
  }
}
